    phone: 'Phone'|t('shipper'),
    address1: 'Address 1'|t('shipper'),
    address2: 'Address 2'|t('shipper'),
    city: 'City'|t('shipper'),
    state: 'State / province'|t('shipper'),
    postalCode: 'Postal code'|t('shipper'),
    countryCode: 'Country code'|t('shipper')
} %}

{% for key, label in shipFromFields %}
    {{ forms.textField({
        label: label,
        id: 'shipFrom-' ~ key,
        name: 'shipFrom[' ~ key ~ ']',
        value: settings.shipFrom[key] ?? '',
        disabled: not isPro
    }) }}
{% endfor %}

{{ forms.selectField({
    label: 'Markup'|t('shipper'),
    instructions: 'Add handling to every quoted rate.'|t('shipper'),
    id: 'rateMarkupType',
    name: 'rateMarkupType',
    options: [
        { label: 'None'|t('shipper'), value: 'none' },
        { label: 'Percentage'|t('shipper'), value: 'percent' },
        { label: 'Flat amount'|t('shipper'), value: 'flat' }
    ],
    value: settings.rateMarkupType,
    disabled: not isPro
}) }}

{{ forms.textField({
    label: 'Markup amount'|t('shipper'),
    id: 'rateMarkupAmount',
    name: 'rateMarkupAmount',
    value: settings.rateMarkupAmount,
    size: 8,
    disabled: not isPro
}) }}

{{ forms.textField({
    label: 'Default item weight'|t('shipper'),
    instructions: 'Assumed for a line item with no weight, in your store’s weight units. Carriers reject a zero-weight parcel.'|t('shipper'),
    id: 'defaultItemWeight',
    name: 'defaultItemWeight',
    value: settings.defaultItemWeight,
    size: 8,
    disabled: not isPro
}) }}

{{ forms.textField({
    label: 'Package code'|t('shipper'),
    id: 'packageCode',
    name: 'packageCode',
    value: settings.packageCode,
    disabled: not isPro
}) }}

{{ forms.textField({
    label: 'Quote cache (seconds)'|t('shipper'),
    instructions: 'How long an identical cart reuses its quote. 0 disables caching, which will make checkout slower and burn API calls.'|t('shipper'),
    id: 'rateCacheDuration',
    name: 'rateCacheDuration',
    value: settings.rateCacheDuration,
    type: 'number',
    size: 6,
    disabled: not isPro
}) }}

{{ forms.textField({
    label: 'Rate timeout (seconds)'|t('shipper'),
    instructions: 'How long checkout waits on ShipStation before carrying on without live rates.'|t('shipper'),
    id: 'rateTimeout',
    name: 'rateTimeout',
    value: settings.rateTimeout,
    type: 'number',
    size: 6,
    disabled: not isPro
}) }}

<div class="field">
    <button type="button" class="btn" id="shipper-quote" {{ not isPro ? 'disabled' : '' }}>{{ 'Quote the most recent cart'|t('shipper') }}</button>
    <span class="light" id="shipper-quote-note"></span>
</div>

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Logging'|t('shipper') }}</h2>

{{ forms.lightswitchField({
    label: 'Log connections'|t('shipper'),
    instructions: 'Record every request ShipStation makes and every call Shipper sends.'|t('shipper'),
    id: 'loggingEnabled',
    name: 'loggingEnabled',
    on: settings.loggingEnabled
}) }}

{{ forms.lightswitchField({
    label: 'Keep payloads'|t('shipper'),
    instructions: 'Store request and response bodies. These can contain customer names and addresses. **Pro.**'|t('shipper'),
    id: 'logPayloads',
    name: 'logPayloads',
    on: settings.logPayloads,
    disabled: not isPro
}) }}

{{ forms.textField({
    label: 'Keep for (days)'|t('shipper'),
    instructions: '0 keeps everything. Run `shipper/log/prune` from cron to enforce it.'|t('shipper'),
    id: 'logRetentionDays',
    name: 'logRetentionDays',
    value: settings.logRetentionDays,
    type: 'number',
    size: 5
}) }}

{% js %}
(function() {
    function note(id, message, isError) {
        var el = document.getElementById(id);
        if (!el) return;
        el.textContent = message;
        el.style.color = isError ? '#CF1124' : '';
    }

    var generate = document.getElementById('shipper-generate-key');
    if (generate) {
        generate.addEventListener('click', function() {
            Craft.sendActionRequest('POST', 'shipper/settings/generate-key')
                .then(function(response) {
                    var input = document.getElementById('authKey');
                    if (input) {
                        input.value = response.data.key;
                        input.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                    note('shipper-generate-key-note', {{ 'Key generated — save to apply it.'|t('shipper')|json_encode|raw }}, false);
                })
                .catch(function() {
                    note('shipper-generate-key-note', {{ 'Couldn’t generate a key.'|t('shipper')|json_encode|raw }}, true);
                });
        });
    }

    var count = document.getElementById('shipper-export-count');
    if (count) {
        count.addEventListener('click', function() {
            note('shipper-export-count-note', '…', false);
            Craft.sendActionRequest('GET', 'shipper/settings/export-count')
                .then(function(response) { note('shipper-export-count-note', response.data.message, !response.data.success); })
                .catch(function() { note('shipper-export-count-note', {{ 'Couldn’t count orders.'|t('shipper')|json_encode|raw }}, true); });
        });
    }

    var test = document.getElementById('shipper-test-connection');
    if (test) {
        test.addEventListener('click', function() {
            note('shipper-test-connection-note', '…', false);
            Craft.sendActionRequest('POST', 'shipper/settings/test-connection')
                .then(function(response) { note('shipper-test-connection-note', response.data.message, !response.data.success); })
                .catch(function(e) { note('shipper-test-connection-note', (e.response && e.response.data && e.response.data.message) || {{ 'Connection failed.'|t('shipper')|json_encode|raw }}, true); });
        });
    }

    var quote = document.getElementById('shipper-quote');
    if (quote) {
        quote.addEventListener('click', function() {
            note('shipper-quote-note', '…', false);
            Craft.sendActionRequest('POST', 'shipper/settings/quote')
                .then(function(response) {
                    var data = response.data;
                    if (data.rates && data.rates.length) {
                        var parts = data.rates.map(function(r) { return r.name + ' ' + r.total; });
                        note('shipper-quote-note', parts.join(' · '), false);
                    } else {
                        note('shipper-quote-note', (data.errors || []).join(' ') || {{ 'No rates returned.'|t('shipper')|json_encode|raw }}, true);
                    }
                })
                .catch(function() { note('shipper-quote-note', {{ 'Quote failed.'|t('shipper')|json_encode|raw }}, true); });
        });
    }
})();
{% endjs %}
